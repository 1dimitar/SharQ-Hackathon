     def two_switch(net, p, q):
         arcs = list(net)
         a, b = arcs[p]
         c, d = arcs[q]
         if a == d or c == b:
             return None
         old = set(net)
         if (a, d) in old or (c, b) in old:
             return None
         old.remove((a, b))
         old.remove((c, d))
         old.add((a, d))
         old.add((c, b))
         return tuple(sorted(old))
 
     def neighborhood(parent, detail):
         arcs = list(parent)
         current = set(parent)
         moves = set()
         prices = detail.get("prices", {}) if detail else {}
         hot = {tuple(map(int, link)) for link, price in prices.items() if price > 0}
         if not hot and detail:
             loads = detail.get("loads", {})
             ranked = sorted(
                 ((float(value), tuple(map(int, link))) for link, value in loads.items()),
                 reverse=True,
             )
             hot = {link for _, link in ranked[:6]}
 
         # Exhaustive two-switches touching a bottleneck, plus sampled unrestricted moves.
         for p in range(len(arcs)):
             for q in range(p + 1, len(arcs)):
                 if hot and arcs[p] not in hot and arcs[q] not in hot:
                     continue
                 move = two_switch(parent, p, q)
                 if move is not None:
                     moves.add(move)
 
         for _ in range(100):
             p = int(rng.integers(len(arcs)))
             q = int(rng.integers(len(arcs) - 1))
             if q >= p:
                 q += 1
             move = two_switch(parent, p, q)
             if move is not None:
                 moves.add(move)
 
         # Three-link rotations add moves that cannot be expressed as a single switch.
         for _ in range(120):
             ids = rng.choice(len(arcs), size=3, replace=False)
             (a, b), (c, d), (e, f) = (arcs[int(i)] for i in ids)
             old = {(a, b), (c, d), (e, f)}
             if hot and not (old & hot):
                 continue
             for new in (
                 {(a, d), (c, f), (e, b)},
                 {(a, f), (c, b), (e, d)},
             ):
                 if len(new) != 3 or any(x == y for x, y in new):
                     continue
                 if new & (current - old):
                     continue
                 moves.add(tuple(sorted((current - old) | new)))
 
         return [
             net for net in moves
             if net != parent and net not in scored
             and not tools.is_cached(net) and tools.is_valid(net)
         ]
 
     def screen(moves, parent, limit=8):
         if not moves:
             return []
         base_energy = energy(parent)
         ranked = sorted(moves, key=lambda net: energy(net) - base_energy)
         selected = []
         # Diversify the high-surrogate-quality choices before filling the batch.
         for net in ranked:
             if all(distance(net, other) >= 3 for other in selected):
                 selected.append(net)
             if len(selected) >= min(5, limit):
                 break
         for net in ranked:
             if len(selected) >= limit:
                 break
             if net not in selected:
                 selected.append(net)
         return selected
 
     def path_relink(parent, target, limit=10):
         """Build valid intermediates that progressively share links with target."""
         current = set(parent)
         target_set = set(target)
         path = []
 
         for _ in range(limit):
             missing = target_set - current
             if not missing:
                 break
 
             proposals = []
             # Insert a missing (u,v) by switching the destinations of
             # (u,w) and (x,v), preserving all in- and out-degrees.
             for u, v in missing:
                 for a, w in current:
                     if a != u or (u, w) in target_set:
                         continue
                     for x, y in current:
                         if y != v or (x, v) in target_set:
                             continue
                         if x == w:
                             continue
                         old = {(u, w), (x, v)}
                         new = {(u, v), (x, w)}
                         if len(new) != 2 or new & (current - old):
                             continue
                         if any(s == d for s, d in new):
                             continue
                         candidate = tuple(sorted((current - old) | new))
                         if candidate != parent and candidate not in scored:
                             if not tools.is_cached(candidate) and tools.is_valid(candidate):
                                 proposals.append(candidate)
 
             if not proposals:
                 break
 
             # Prefer intermediates with good surrogate energy, breaking ties
             # in favor of greater overlap with the destination network.
             candidate = min(
                 set(proposals),
                 key=lambda net: (
                     energy(net),
                     -len(set(net) & target_set),
                 ),
             )
             current = set(candidate)
             path.append(candidate)
 
         return path
 
     while tools.lp_calls_left > 0:
         pop = frontier()
         if not pop:
             break
         parent = select_parent(pop)
         try:
             detail = tools.lp_detail(parent)
         except Exception:
             detail = None
 
         batch = screen(neighborhood(parent, detail), parent)
 
         # If this neighborhood is exhausted, try another frontier member.
         if not batch:
             alternatives = [net for net in pop if net != parent]
             rng.shuffle(alternatives)
             for alternative in alternatives[:6]:
                 try:
                     alt_detail = tools.lp_detail(alternative)
                 except Exception:
                     alt_detail = None
                 batch = screen(neighborhood(alternative, alt_detail), alternative)
                 if batch:
                     parent = alternative
                     break
 
         if stalls.get(parent, 0) >= 2 and len(pop) > 1:
             elite = sorted(pop, key=scored.get)[:12]
             targets = [net for net in elite if net != parent and distance(net, parent) >= 8]
             if targets:
                 target = max(targets, key=lambda net: (distance(net, parent), -scored[net]))
                 relinked = path_relink(parent, target)
                 relink_batch = screen(relinked, parent, limit=4)
                 if relink_batch:
                     batch = batch[:5] + [
                         net for net in relink_batch if net not in batch
                     ][:3]
 
         if not batch:
             # A small random sequence of valid two-switches helps escape exhausted basins.
             for _ in range(80):
                 cur = set(parent)
                 for _ in range(3 + int(rng.integers(4))):
                     now = list(cur)
                     p, q = rng.choice(len(now), size=2, replace=False)
                     a, b = now[int(p)]
                     c, d = now[int(q)]
                     if a == d or c == b or (a, d) in cur or (c, b) in cur:
                         continue
                     cur.remove((a, b))
                     cur.remove((c, d))
                     cur.add((a, d))
                     cur.add((c, b))
                 kicked = tuple(sorted(cur))
                 if (kicked != parent and kicked not in scored
                         and not tools.is_cached(kicked) and tools.is_valid(kicked)):
                     batch = [kicked]
                     break
 
         if not batch:
             break
 
         old_score = scored.get(parent, float("inf"))
         for net in batch:
             if tools.lp_calls_left <= 0:
                 break
             try:
                 evaluate(net)
             except Exception as exc:
                 if type(exc).__name__ == "BudgetExhausted":
                     return list(best_net) if best_net is not None else []
         if min((scored.get(net, float("inf")) for net in batch), default=float("inf")) < old_score:
             stalls[parent] = 0
+            parent_gains[parent] = parent_gains.get(parent, 0) + 1
         else:
             stalls[parent] = stalls.get(parent, 0) + 1
 
     return list(best_net) if best_net is not None else []
