                 return route_cache[net]
             peaks.append(float(np.max(loads)))
 
         # The worst tie-breaking is a robustness signal; the mean tempers its noise.
         estimate = 0.65 * max(peaks) + 0.35 * sum(peaks) / len(peaks)
         route_cache[net] = estimate
         return estimate
 
     def exchange(net, p, q):
         """A directed 2-switch; it preserves all in- and out-degrees."""
         if p == q:
             return None
         arcs = list(net)
         (a, b), (c, d) = arcs[p], arcs[q]
         if a == d or c == b:
             return None
         current = set(net)
         if (a, d) in current or (c, b) in current:
             return None
         current.remove((a, b))
         current.remove((c, d))
         current.add((a, d))
         current.add((c, b))
         return tuple(sorted(current))
 
