                             break
                         nxt = min(
                             choices,
                             key=lambda v: (
                                 (v * v + (variant + 1) * v
                                  + source * (variant + 2)
                                  + destination * (variant + 3)) % (n + 1),
                                 v,
                             ),
                         )
                         loads[node, nxt] += amount
                         node = nxt
                         steps += 1
                         if steps > n:
