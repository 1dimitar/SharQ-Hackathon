 """Surrogate QUBO terms for QOBLIB 08 network design. ShinkaEvolve edits the EVOLVE block."""
 
 import time
 
 # EVOLVE-BLOCK-START
 import numpy as np
 
 
 def surrogate_terms(demand):
     """Build the surrogate cost terms of the topology QUBO from the demand matrix.
 
     Args:
         demand: (n, n) float array; demand[i, j] is the traffic from node i to node j
             (zero diagonal).
 
     Returns:
         linear: dict {(i, j): weight}. Weight on the binary variable x_ij
             (x_ij = 1 if the directed link i -> j is built), i != j.
         quadratic: dict {((i, j), (k, l)): weight}. Weight on the product x_ij * x_kl.
         penalty_weight: float. Strength of the degree penalty that the evaluator adds
             after rescaling these terms so the largest |weight| is 1.
 
     Lower energy must mean a better topology. Baseline: reward each link by the demand
     it carries directly.
     """
     d = np.asarray(demand, dtype=float)
     n = len(d)
     scale = float(d.max()) or 1.0
     ds = d / scale
 
-    # Keep the baseline incentive for links carrying substantial direct traffic.
+    # Retain the direct-service signal, but compress its range so a few
+    # exceptionally large OD pairs do not overwhelm moderate demands.
     linear = {
-        (i, j): -float(ds[i, j])
+        (i, j): -float(np.sqrt(max(0.0, ds[i, j])))
         for i in range(n) for j in range(n) if i != j
     }
 
     # A node is a more credible relay when it has both traffic arriving and
     # traffic leaving. This downweights two-hop paths through one-sided nodes.
     row = ds.sum(axis=1)
     col = ds.sum(axis=0)
     relay = np.sqrt(np.maximum(row, 0.0) * np.maximum(col, 0.0))
     rmax = float(relay.max()) or 1.0
     relay = relay / rmax
 
     quadratic = {}
     for i in range(n):
         for k in range(n):
             if i == k or ds[i, k] <= 0:
                 continue
             candidates = []
             for j in range(n):
                 if j != i and j != k and relay[j] > 0:
                     # Prefer relays connected to both sides of this OD pair.
                     suitability = relay[j] * (
                         0.25 + 0.75 * min(1.0, ds[i, j] + ds[j, k])
                     )
                     if suitability > 0:
                         candidates.append((j, suitability))
             total = sum(v for _, v in candidates)
             if total <= 0:
                 continue
             for j, suitability in candidates:
                 a, b = (i, j), (j, k)
                 key = (a, b) if a < b else (b, a)
                 # Discount indirect service and distribute the OD reward over
                 # candidate relays, preventing high-degree interaction bias.
                 quadratic[key] = quadratic.get(key, 0.0) - (
                     0.30 * float(ds[i, k]) * suitability / total
                 )
 
     penalty_weight = 3.0
     return linear, quadratic, penalty_weight
 
 
 # EVOLVE-BLOCK-END
 
 
 def run_surrogate(demand):
     """Fixed entry point called by the evaluator, once per demand matrix."""
     demand = np.array(demand, dtype=float)
     start = time.perf_counter()
     linear, quadratic, penalty_weight = surrogate_terms(demand.copy())
     return {
         "n": len(demand),
         "linear": linear,
         "quadratic": quadratic,
         "penalty_weight": penalty_weight,
         "seconds": time.perf_counter() - start,
     }
