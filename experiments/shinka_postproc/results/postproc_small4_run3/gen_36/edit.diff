+        dist[:, np.arange(n), np.arange(n)] = 0.0
+
+        s0 = successors[:, :, 0]
+        s1 = successors[:, :, 1]
+        dist[bb, nodes, s0] = edge_lengths[:, :, 0]
+        dist[bb, nodes, s1] = edge_lengths[:, :, 1]
+        for k in range(n):
+            np.minimum(
+                dist,
+                dist[:, :, k, None] + dist[:, None, k, :],
